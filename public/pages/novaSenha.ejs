<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="../Img/Mask group.png" type="image/x-icon">
    <link rel="stylesheet" href="../css/global.css">
    <link rel="stylesheet" href="../css/redefinirSenha.css"> 
    <title>Redefinir Senha</title>
</head>
<body>
    <header class="header-primary-d_flex-space_between">
        <img src="../Img/Logo.png" alt="LogoTipo">
        <nav>
            <a href=""></a>
            <a href=""></a>
            <a href=""></a>
        </nav>
    </header>
    <main class="main-primary bg-primary-linear">
        <section class="section-redefinirSenha">
            <h1>Informe a nova senha</h1>
            <p>Definindo nova senha para: <strong><%= email %></strong></p>
            
            <form action="/novaSenha" method="post">
                
                <input type="hidden" name="email" value="<%= email %>">

                <input type="password" name="novaSenha" placeholder="Digite sua Nova Senha" required class="input-form">
                
                <input type="password" name="confirmar-senha" placeholder="Confirme a Senha" required class="input-form">
                
                <button class="btn-primary" type="submit">Confirmar</button>
            </form>
        </section>
    </main>
    <footer>
        <img src="../Img/Logo2.png" alt="">
        <p>&copy; 2025 WaterFlow. Todos os direitos reservados | Projeto TCC</p>
    </footer>
</body>
</html>